[node name="EndTurn" type="Button" parent="Margin/Layout/PlayArea/Sidebar"]
layout_mode = 2
text = "End turn"

[node name="KingdomTitle" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/KingdomCard/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "YOUR KINGDOM"

[node name="KingdomHint" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/KingdomCard/Box"]

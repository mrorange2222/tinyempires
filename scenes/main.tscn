text = "Victory"
horizontal_alignment = 1

[node name="Detail" type="Label" parent="Result/Center/Card/Content"]
layout_mode = 2
text = "Capital captured."
horizontal_alignment = 1

[node name="Restart" type="Button" parent="Result/Center/Card/Content"]
layout_mode = 2

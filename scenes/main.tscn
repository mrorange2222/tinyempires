[node name="HistoryTitle" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/HistoryCard/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "RECENT MOVES"

[node name="History" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/HistoryCard/Box"]
layout_mode = 2
text = "No moves yet."
autowrap_mode = 2

[node name="Legend" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "New match. Click one of your tiles to begin."
autowrap_mode = 2

[node name="Selection" type="Label" parent="Margin/Layout"]
visible = false
layout_mode = 2
text = "Select land to inspect it."
autowrap_mode = 2

[node name="RulesDialog" type="AcceptDialog" parent="."]
title = "Rules"
size = Vector2i(650, 540)
dialog_autowrap = true

[node name="Result" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.05, 0.07, 0.88)

[node name="Center" type="CenterContainer" parent="Result"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Card" type="PanelContainer" parent="Result/Center"]
custom_minimum_size = Vector2(430, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Result/Center/Card"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Result/Center/Card/Content"]
layout_mode = 2

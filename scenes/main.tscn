[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/main.gd" id="1_main"]
[ext_resource type="Script" path="res://ui/hex_board.gd" id="2_board"]
[ext_resource type="Script" path="res://ui/icon.gd" id="3_icon"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_play_area"]
bg_color = Color(0.055, 0.13, 0.17, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.20, 0.29, 0.31, 1)

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Emblem" type="Control" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(22, 22)
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("3_icon")
kind = "crown"
tint = Color(0.89, 0.81, 0.58, 1)

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "The Tiny Empire"

[node name="Stats" type="HBoxContainer" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Player" type="PanelContainer" parent="Margin/Layout/Header/Stats"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Row" type="HBoxContainer" parent="Margin/Layout/Header/Stats/Player"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="Margin/Layout/Header/Stats/Player/Row"]
layout_mode = 2
size_flags_horizontal = 3
text = "YOU"

[node name="Rival" type="PanelContainer" parent="Margin/Layout/Header/Stats"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Row" type="HBoxContainer" parent="Margin/Layout/Header/Stats/Rival"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="Margin/Layout/Header/Stats/Rival/Row"]
layout_mode = 2
size_flags_horizontal = 3
text = "RIVAL"

[node name="Turn" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
text = "ROUND 01"

[node name="Rules" type="Button" parent="Margin/Layout/Header"]
layout_mode = 2
text = "Rules"

[node name="Exit" type="Button" parent="Margin/Layout/Header"]
layout_mode = 2
text = "Menu"

[node name="Instructions" type="Label" parent="Margin/Layout"]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Click your tile, then a neighbouring tile to move, attack or claim. Soldiers show armies (the tag gives the exact number); a bright dot means they can still act; grey soldiers are done for this turn."
autowrap_mode = 2

[node name="PlayArea" type="BoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/PlayArea"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 1
theme_override_styles/panel = SubResource("StyleBoxFlat_play_area")

[node name="Board" type="Control" parent="Margin/Layout/PlayArea/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("2_board")

[node name="Sidebar" type="VBoxContainer" parent="Margin/Layout/PlayArea"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_constants/separation = 6

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/PlayArea/Sidebar"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="BoxContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll"]
layout_mode = 2
vertical = true
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="SelectionCard" type="PanelContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ActionCard" type="PanelContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="KingdomCard" type="PanelContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/KingdomCard"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HistoryCard" type="PanelContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/HistoryCard"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TileTitle" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Select a tile"
autowrap_mode = 2

[node name="TileDetail" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard/Box"]
layout_mode = 2
text = "Click one of your tiles to start."
autowrap_mode = 2

[node name="Recruit" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard/Box"]
layout_mode = 2
text = "Recruit +2 armies here  -  3 gold"

[node name="Improve" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard/Box"]
layout_mode = 2
text = "Improve  -  3 gold, +1 gold/round"

[node name="Expand" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard/Box"]
layout_mode = 2
text = "Claim this land  -  3 gold"

[node name="Fort" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/SelectionCard/Box"]
layout_mode = 2
text = "Build fort  -  6 gold, +5 defense"

[node name="TargetTitle" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Move"
autowrap_mode = 2

[node name="Count" type="HBoxContainer" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Less" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box/Count"]
layout_mode = 2
text = "-"

[node name="Label" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box/Count"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
text = "Send 1 of 1"

[node name="More" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box/Count"]
layout_mode = 2
text = "+"

[node name="Move" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box"]
layout_mode = 2
text = "Move armies"

[node name="Attack" type="Button" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box"]
layout_mode = 2
text = "Attack"

[node name="Preview" type="Label" parent="Margin/Layout/PlayArea/Sidebar/Scroll/Content/ActionCard/Box"]
layout_mode = 2
text = ""
